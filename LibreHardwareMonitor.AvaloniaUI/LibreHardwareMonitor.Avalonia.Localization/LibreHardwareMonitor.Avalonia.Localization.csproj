<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Resources.resx">
      <StronglyTypedClassName>Resources</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)Resources.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>LibreHardwareMonitor.Avalonia.Localization.Resources</StronglyTypedNamespace>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
    <Compile Remove="Resources\Resources.Designer.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BlackSharp.Core" Version="1.2.6" />
  </ItemGroup>

  <Target Name="PrepareLocalizationResourcesForDesignTime" BeforeTargets="CoreCompile" DependsOnTargets="PrepareResources" Condition="'$(DesignTimeBuild)' == 'true'" />
</Project>
