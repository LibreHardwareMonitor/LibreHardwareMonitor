<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>x64;x86;ARM64</Platforms>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x64'">$([System.Text.RegularExpressions.Regex]::Replace('$(NETCoreSdkPortableRuntimeIdentifier)', '-[^-]+$', '-x64'))</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x86'">$([System.Text.RegularExpressions.Regex]::Replace('$(NETCoreSdkPortableRuntimeIdentifier)', '-[^-]+$', '-x86'))</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">$([System.Text.RegularExpressions.Regex]::Replace('$(NETCoreSdkPortableRuntimeIdentifier)', '-[^-]+$', '-arm64'))</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</RuntimeIdentifier>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>LibreHardwareMonitor</AssemblyTitle>
    <ApplicationIcon>..\LibreHardwareMonitor.Avalonia.UI\Assets\Brand\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="BlackSharp.Core" Version="1.2.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LibreHardwareMonitor.Avalonia.UI\LibreHardwareMonitor.Avalonia.UI.csproj" />
  </ItemGroup>
</Project>
